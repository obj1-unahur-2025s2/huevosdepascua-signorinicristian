import huevosDePascua.*
import chicos.*
import caceriadeHuevos.*

describe "group of tests" {

  method initialize() {
    caceria.inicializarJuego()
  }

  test "Matrioshka es el huevo de mas calorias" {
    caceria.inicializarJuego()
    assert.equals(matrioshka, caceria.huevoPorEncontrarConMasCalorias())
  }
  test "test 2" {
    caceria.encontrarPrimerHuevoPor(ana)
    assert.equals(3, caceria.cantidadPorEncontrar())
    assert.equals(2, caceria.cuantosConChocoBlanco())
    assert.that(caceria.aunNoFueEncontrado(conejo))
    assert.equals([huevoRepostero, huevoMixto], caceria.chocoBlancoPorEncontrar())
    caceria.encontrarUnHuevoPor(tito, huevoMixto)
    caceria.encontrarHuevosRestantes(jose)
    assert.that(ana.estaEnfermo())
    assert.that(jose.estaEnfermo())
  }

}